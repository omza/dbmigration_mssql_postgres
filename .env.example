# --- Verbindungen -----------------------------------------------------------
# PostgreSQL (libpq-DSN oder URI)
PG_DSN=postgresql://migration:secret@localhost:5432/energydwh
# MS SQL Server (ODBC-Stil; mssql-python oder pyodbc)
MSSQL_CONN=SERVER=localhost,1433;DATABASE=EnergyDWH;UID=migration;PWD=secret;Encrypt=yes;TrustServerCertificate=yes

# --- Pfade ------------------------------------------------------------------
# Lokaler Clone des Git-Repos mit den täglich gescripteten MSSQL-Objekten
MSSQL_SOURCE_DIR=../energydwh-scripts
# Generierte PG-DDL (wird von `clear` gelöscht und von `mig` neu erzeugt)
OUT_DIR=out
# Handgepflegte PG-Objekte, haben Vorrang vor generierten
OVERRIDES_DIR=overrides
# Projektdaten: Umbenennungen, Chunk-Spalten, ausgeschlossene Objekte
MAPPING_FILE=mapping.yml

# --- Schemas ----------------------------------------------------------------
# Kommagetrennt; werden weder migriert noch deployt noch kopiert
SCHEMA_BLACKLIST=
# Schema, das Talend mit Tabellen und Daten befüllt: Daten werden nie kopiert
RAW_SCHEMA=raw
# true: RAW-Tabellen per mig/deploy anlegen | false: RAW wird nicht angefasst (Talend legt an)
RAW_DDL=true

# --- Datenkopie -------------------------------------------------------------
COPY_WORKERS=4
COPY_CHUNK_ROWS=5000000
COPY_FETCH_SIZE=10000
